<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name="com.sothikdor.app.SothikDorApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SothikDor"
        android:usesCleartextTraffic="true">
        <activity android:name="com.sothikdor.app.activities.SplashActivity" android:exported="true"
            android:theme="@style/Theme.SothikDor.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.sothikdor.app.activities.LoginActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.sothikdor.app.activities.MainActivity" android:exported="false" />
        <activity android:name="com.sothikdor.app.activities.ChartActivity" android:exported="false"
            android:parentActivityName="com.sothikdor.app.activities.MainActivity" />
        <activity android:name="com.sothikdor.app.activities.CompareActivity" android:exported="false"
            android:parentActivityName="com.sothikdor.app.activities.MainActivity" />
        <activity android:name="com.sothikdor.app.activities.BudgetActivity" android:exported="false"
            android:parentActivityName="com.sothikdor.app.activities.MainActivity" />
        <activity android:name="com.sothikdor.app.activities.MapActivity" android:exported="false"
            android:parentActivityName="com.sothikdor.app.activities.MainActivity" />
        <activity android:name="com.sothikdor.app.activities.ProfileActivity" android:exported="false"
            android:parentActivityName="com.sothikdor.app.activities.MainActivity" />
        <meta-data android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_GOOGLE_MAPS_API_KEY_HERE" />
        <activity android:name="com.sothikdor.app.activities.ComplaintActivity" android:exported="false"/>
    </application>
</manifest>
