<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical">
    <!-- Market Info -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/green_primary" android:padding="14dp">
        <TextView android:id="@+id/tvMarketInfo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>
    <!-- Budget List -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerBudget"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:clipToPadding="false" />
    <!-- Total Footer -->
    <androidx.cardview.widget.CardView android:layout_width="match_parent"
        android:layout_height="wrap_content" app:cardElevation="8dp"
        app:cardCornerRadius="0dp" app:cardBackgroundColor="@color/green_primary">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="মোট খরচ" android:textColor="#CCFFFFFF" android:textSize="13sp" />
                    <TextView android:id="@+id/tvTotalCost" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="৳০"
                        android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/tvItemCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="০টি পণ্য"
                    android:textColor="@color/amber_primary" android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearAll" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="46dp" android:text="মুছুন"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/white" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare" android:layout_width="0dp" android:layout_weight="2"
                    android:layout_height="46dp" android:text="📤 শেয়ার করুন"
                    android:backgroundTint="@color/amber_primary" android:textColor="#333333"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
